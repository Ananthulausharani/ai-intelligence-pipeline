# Copy this file to .env and fill in your values

# LLM Providers (Priority Order: Gemini Flash -> Groq Llama -> DeepSeek)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Optional LLM Model Overrides
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_MODEL=deepseek-chat

# Production Storage (PostgreSQL System of Record)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_intelligence

# Crawling Configuration
CRAWL_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# Google Sheets Integration (Step 27B)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_PUBLIC=false

